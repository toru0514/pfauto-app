# App URL (used for NextAuth callbacks etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth credentials admin user
ADMIN_EMAIL=admin@example.com
# Generate hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2a$10$EXAMPLE_HASH_REPLACE_ME
NEXTAUTH_SECRET=replace-with-strong-secret

# Google Sheets integration (set when ready)
GOOGLE_SERVICE_ACCOUNT_BASE64=<base64-encoded service account json>
GOOGLE_SHEETS_SPREADSHEET_ID=<spreadsheet-id>
GOOGLE_SHEETS_WORKSHEET_TITLE=シート1
USE_MOCK_SHEETS_DATA=false

# Playwright credentials placeholders
PLAYWRIGHT_CREEMA_EMAIL=
PLAYWRIGHT_CREEMA_PASSWORD=
PLAYWRIGHT_MINNE_EMAIL=
PLAYWRIGHT_MINNE_PASSWORD=
PLAYWRIGHT_RUN_MINNE=false
PLAYWRIGHT_RUN_CREEMA=false
PLAYWRIGHT_BASE_EMAIL=
PLAYWRIGHT_BASE_PASSWORD=
PLAYWRIGHT_RUN_BASE=false
PLAYWRIGHT_IICHI_EMAIL=
PLAYWRIGHT_IICHI_PASSWORD=
PLAYWRIGHT_RUN_IICHI=false
CREEMA_BASE_URL=https://www.creema.jp
BASE_BASE_URL=https://admin.thebase.com

# Sentry error monitoring (optional - leave empty to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Slack notifications (optional)
SLACK_WEBHOOK_URL=

# Logging
LOG_LEVEL=info
